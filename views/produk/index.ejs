<div class="page-stack">
  <section class="section">
    <div class="section-header">
      <div>
        <h3>Ringkasan Produk</h3>
        <p>Status stok dan total kategori</p>
      </div>
      <div class="section-actions">
        <a href="/produk/baru" class="btn btn-primary">Tambah Produk</a>
      </div>
    </div>
    <div class="section-body">
      <ul class="kv-list summary-list" id="productCounts">
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h3>Daftar Produk</h3>
        <p>Cari, filter by kategori/stok/status, dan sort by data produk</p>
      </div>
    </div>
    <div class="section-body">
      <form id="filterForm">
        <div class="filter-bar">
          <label class="filter-search">
            Cari:
            <input type="text" name="q" id="fQ" placeholder="Nama produk...">
          </label>
          <label>
            Filter By Kategori:
            <select name="kategori" id="fKategori">
              <option value="">Semua</option>
            </select>
          </label>
          <label>
            Filter By Stok:
            <select name="stok" id="fStok">
              <option value="">Semua</option>
              <option value="tersedia">Tersedia</option>
              <option value="rendah">Stok Rendah</option>
              <option value="habis">Habis</option>
            </select>
          </label>
          <label>
            Filter By Status:
            <select name="aktif" id="fAktif">
              <option value="">Semua</option>
              <option value="1">Aktif</option>
              <option value="0">Nonaktif</option>
            </select>
          </label>
          <label>
            Sort By:
            <select name="sort" id="fSort">
              <option value="terbaru">Terbaru</option>
              <option value="terlama">Terlama</option>
              <option value="nama_asc">Nama A-Z</option>
              <option value="nama_desc">Nama Z-A</option>
              <option value="termurah">Harga Termurah</option>
              <option value="termahal">Harga Termahal</option>
              <option value="stok_rendah">Stok Rendah</option>
              <option value="stok_banyak">Stok Terbanyak</option>
              <option value="kategori">Kategori</option>
            </select>
          </label>
          <button type="submit" class="btn">Terapkan</button>
        </div>
      </form>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Nama Produk</th>
              <th>Kategori</th>
              <th>Harga</th>
              <th>Stok</th>
              <th>Berat</th>
              <th>Status Stok</th>
              <th>Status Produk</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="productRows">
          </tbody>
        </table>
      </div>

      <p class="text-muted" id="resultInfo"></p>
    </div>
  </section>
</div>

<script>
  const FILTER_KATEGORI = [
    [33, 'Aksesori Busana'],
    [62, 'Aksesori Komputer'],
    [23, 'Area Mandi Rumah'],
    [17, 'Aroma Tubuh'],
    [29, 'Atasan Harian'],
    [59, 'Audio Harian'],
    [48, 'Bahan Kue'],
    [30, 'Bawahan Harian'],
    [12, 'Bayi Keluarga'],
    [10, 'Bekal dan Makanan'],
    [58, 'Belajar Anak'],
    [47, 'Botol dan Kotak Bekal'],
    [36, 'Buku Catatan'],
    [27, 'Bumbu dan Rempah'],
    [44, 'Camilan Kering'],
    [6, 'Dapur Nusantara'],
    [20, 'Dekorasi Ruang'],
    [13, 'Digital dan Aksesori'],
    [1, 'Elektronik'],
    [2, 'Fashion'],
    [7, 'Gaya Sehari Hari'],
    [9, 'Hobi Kreatif'],
    [60, 'Kabel dan Charger'],
    [53, 'Keamanan Perjalanan'],
    [18, 'Kebersihan Pribadi'],
    [21, 'Kebersihan Rumah'],
    [39, 'Kerajinan Tangan'],
    [43, 'Koleksi Mini'],
    [46, 'Kopi dan Teh'],
    [38, 'Lampu Kerja'],
    [40, 'Lukis dan Gambar'],
    [55, 'Mainan Anak'],
    [56, 'Makan Bayi'],
    [45, 'Makanan Instan'],
    [35, 'Meja dan Organizer'],
    [28, 'Minuman Hangat'],
    [41, 'Musik Ringan'],
    [52, 'Olahraga Ringan'],
    [54, 'Pakaian Bayi'],
    [61, 'Pelindung Gadget'],
    [63, 'Pencahayaan Digital'],
    [19, 'Penyimpanan Rumah'],
    [25, 'Peralatan Makan'],
    [24, 'Peralatan Masak'],
    [37, 'Perangkat Kerja'],
    [57, 'Perawatan Bayi'],
    [4, 'Perawatan Diri'],
    [16, 'Perawatan Rambut'],
    [15, 'Perawatan Wajah'],
    [11, 'Perjalanan dan Outdoor'],
    [50, 'Perlengkapan Hujan'],
    [5, 'Perlengkapan Rumah'],
    [34, 'Perlengkapan Tulis'],
    [42, 'Permainan Meja'],
    [8, 'Ruang Kerja'],
    [22, 'Ruang Tidur Rumah'],
    [3, 'Rumah Tangga'],
    [14, 'Sabun dan Sampo'],
    [31, 'Sepatu dan Sandal'],
    [32, 'Tas Harian'],
    [49, 'Tas Perjalanan'],
    [51, 'Tidur Outdoor'],
    [26, 'Wadah Dapur']
  ];

  async function loadKategori() {
    try {
      const sel = document.getElementById('fKategori');
      for (const [id, nama] of FILTER_KATEGORI) {
        sel.appendChild(el('option', { value: id }, nama));
      }
      const url = new URLSearchParams(location.search);
      if (url.get('kategori')) sel.value = url.get('kategori');
    } catch (err) { showError(err.message); }
  }

  async function loadProducts() {
    const params = new URLSearchParams({
      q:        document.getElementById('fQ').value,
      kategori: document.getElementById('fKategori').value,
      stok:     document.getElementById('fStok').value,
      aktif:    document.getElementById('fAktif').value,
      sort:     document.getElementById('fSort').value
    });
    for (const k of [...params.keys()]) if (!params.get(k)) params.delete(k);

    try {
      const out = await API.get('/api/produk?' + params.toString());
      const c = out.counts;
      document.getElementById('productCounts').innerHTML = `
        <li>Total Produk: <strong>${c.total_produk}</strong></li>
        <li>Total Kategori: <strong>${c.kategori_aktif}</strong></li>
        <li>Stok Rendah: <strong>${c.stok_rendah}</strong></li>
        <li>Stok Habis: <strong>${c.stok_habis}</strong></li>
      `;

      const tbody = document.getElementById('productRows');
      clear(tbody);
      if (!out.data.length) {
        tbody.appendChild(el('tr', null, el('td', { colspan: 8 }, 'Tidak ada produk.')));
      } else {
        for (const p of out.data) {
          let stok = 'Tersedia';
          if (p.stok === 0)      stok = 'Habis';
          else if (p.stok <= 10) stok = 'Stok Rendah';

          const editLink = el('a', { href: `/produk/${p.id_produk}/edit` }, 'Edit');
          const delBtn = el('button', {
            class: 'link-btn',
            onclick: async () => {
              if (!confirm('Hapus produk ini?')) return;
              try {
                await API.del('/api/produk/' + p.id_produk);
                showSuccess('Produk dihapus.');
                loadProducts();
              } catch (err) { showError(err.message); }
            }
          }, 'Hapus');

          tbody.appendChild(el('tr', null,
            el('td', null, p.nama_produk),
            el('td', null, p.nama_kategori),
            el('td', null, rupiah(p.harga)),
            el('td', null, p.stok + ' unit'),
            el('td', null, p.berat_gram + ' g'),
            el('td', null, stok),
            el('td', null, p.is_active ? 'Aktif' : 'Nonaktif'),
            el('td', null, editLink, ' | ', delBtn)
          ));
        }
      }
      document.getElementById('resultInfo').textContent =
        `Menampilkan ${out.data.length} dari ${c.total_produk} produk.`;
    } catch (err) { showError(err.message); }
  }

  document.getElementById('filterForm').addEventListener('submit', (e) => {
    e.preventDefault();
    loadProducts();
  });
  document.getElementById('fKategori').addEventListener('change', loadProducts);
  document.getElementById('fStok').addEventListener('change', loadProducts);
  document.getElementById('fAktif').addEventListener('change', loadProducts);
  document.getElementById('fSort').addEventListener('change', loadProducts);

  (async () => {
    await loadKategori();
    document.getElementById('resultInfo').textContent = '';
  })();
</script>
