<div class="page-stack">
  <section class="section">
    <div class="section-header">
      <div>
        <h3>Input Pengiriman</h3>
        <p>Buat data pengiriman secara manual</p>
      </div>
      <div class="section-actions">
        <button type="button" class="btn" data-toggle-panel="addShipmentPanel" data-closed-label="Input Pengiriman" data-open-label="Tutup Input">Input Pengiriman</button>
      </div>
    </div>
    <div class="section-body input-panel is-hidden" id="addShipmentPanel">
      <form id="addShipmentForm" class="filter-bar">
        <label>
          Pesanan:
          <select id="shipOrder" required></select>
        </label>
        <label>
          Kurir:
          <select id="shipKurir" required></select>
        </label>
        <label>
          Layanan:
          <input type="text" id="shipLayanan" placeholder="REG, Express...">
        </label>
        <label>
          No. Resi:
          <input type="text" id="shipResi" required>
        </label>
        <label>
          Ongkir:
          <input type="number" id="shipOngkir" min="0" value="0">
        </label>
        <label>
          Berat (gram):
          <input type="number" id="shipBerat" min="0" value="0">
        </label>
        <label>
          Tanggal Kirim:
          <input type="datetime-local" id="shipTanggal">
        </label>
        <label>
          Estimasi Tiba:
          <input type="date" id="shipEstimasi" required>
        </label>
        <label>
          Status:
          <select id="shipStatus">
            <option value="diproses">Diproses</option>
            <option value="dalam_perjalanan">Dalam Perjalanan</option>
            <option value="tiba_di_kota">Tiba di Kota</option>
            <option value="out_for_delivery">Sedang Diantar</option>
            <option value="terkirim">Terkirim</option>
            <option value="gagal_kirim">Gagal</option>
            <option value="retur">Retur</option>
          </select>
        </label>
        <label>
          Riwayat Awal:
          <input type="text" id="shipRiwayat" placeholder="Opsional">
        </label>
        <button type="submit" class="btn btn-primary">Tambah Pengiriman</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h3>Daftar Pengiriman</h3>
        <p>Cari, filter by kurir/status, sort by pengiriman, dan koreksi data resi</p>
      </div>
    </div>
    <div class="section-body">
      <form id="shipmentFilterForm" class="filter-bar">
        <label class="filter-search">
          Cari:
          <input type="text" id="listQ" placeholder="No. resi, ID pesanan, pelanggan...">
        </label>
        <label>
          Filter By Status Kirim:
          <select id="listStatus">
            <option value="">Semua</option>
            <option value="diproses">Diproses</option>
            <option value="dalam_perjalanan">Dalam Perjalanan</option>
            <option value="tiba_di_kota">Tiba di Kota</option>
            <option value="out_for_delivery">Sedang Diantar</option>
            <option value="terkirim">Terkirim</option>
            <option value="gagal_kirim">Gagal</option>
            <option value="retur">Retur</option>
          </select>
        </label>
        <label>
          Filter By Kurir:
          <select id="listKurir">
            <option value="">Semua</option>
          </select>
        </label>
        <label>
          Filter By Status Pesanan:
          <select id="listOrderStatus">
            <option value="">Semua</option>
            <option value="menunggu_bayar">Menunggu Bayar</option>
            <option value="diproses">Diproses</option>
            <option value="dikirim">Dikirim</option>
            <option value="selesai">Selesai</option>
            <option value="dibatalkan">Dibatalkan</option>
          </select>
        </label>
        <label>
          Sort By:
          <select id="listSort">
            <option value="terbaru">Tanggal Kirim Terbaru</option>
            <option value="terlama">Tanggal Kirim Terlama</option>
            <option value="estimasi_terdekat">Estimasi Terdekat</option>
            <option value="estimasi_terjauh">Estimasi Terjauh</option>
            <option value="status">Status Kirim</option>
            <option value="kurir">Kurir</option>
            <option value="pelanggan">Pelanggan A-Z</option>
          </select>
        </label>
        <button type="submit" class="btn">Filter</button>
      </form>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Pesanan</th>
              <th>Pelanggan</th>
              <th>Kurir</th>
              <th>Resi</th>
              <th>Tanggal</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="shipmentRows">
          </tbody>
        </table>
      </div>
      <p class="text-muted" id="shipmentResultInfo"></p>
    </div>
  </section>

  <div class="page-split equal-split">
    <section class="section control-panel">
      <div class="section-header">
        <div>
          <h3>Lacak Paket</h3>
          <p>Cari resi atau tampilkan paket aktif per kurir</p>
        </div>
      </div>
      <div class="section-body">
        <form id="trackForm" class="filter-bar vertical-form">
          <label class="filter-search">
            No. Resi:
            <input type="text" id="fQ" placeholder="contoh: JNE00123456789">
          </label>
          <label>
            Kurir:
            <select id="fKurir">
              <option value="">Semua</option>
            </select>
          </label>
          <button type="submit" class="btn">Cari</button>
        </form>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <h3>Ringkasan Kurir</h3>
          <p>Total paket per kurir</p>
        </div>
      </div>
      <div class="section-body">
        <table class="table compact-table">
          <thead>
            <tr>
              <th>Kurir</th>
              <th>Total Paket</th>
              <th>Terkirim</th>
              <th>Dalam Perjalanan</th>
            </tr>
          </thead>
          <tbody id="kurirRows">
            <tr><td colspan="4">Memuat...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div id="trackingDetail"></div>
</div>

<script>
  const FILTER_KURIR = [
    { kode: 'JNE', label: 'JNE - JNE' },
    { kode: 'JNT', label: 'JNT - JNT' },
    { kode: 'SICEPAT', label: 'SICEPAT - SiCepat' }
  ];

  function pad(n, w) { return String(n).padStart(w, '0'); }

  function fillKurirOptions(selectId) {
    const sel = document.getElementById(selectId);
    while (sel.options.length > 1) sel.remove(1);
    for (const k of FILTER_KURIR) {
      sel.appendChild(el('option', { value: k.kode }, k.label));
    }
  }

  function initFilterOptions() {
    fillKurirOptions('listKurir');
    fillKurirOptions('fKurir');
  }

  let shipmentOptionsLoaded = false;

  async function loadShipmentOptions() {
    const out = await API.get('/api/pengiriman/options');
    const orderSel = document.getElementById('shipOrder');
    const kurirSel = document.getElementById('shipKurir');
    clear(orderSel);
    clear(kurirSel);

    orderSel.appendChild(el('option', { value: '' }, 'Pilih pesanan'));
    for (const o of out.orders) {
      orderSel.appendChild(el('option', { value: o.id_pesanan },
        `#TK-${pad(o.id_pesanan, 4)} - ${o.pelanggan_nama} - ${rupiah(o.total_tagihan)}`
      ));
    }

    kurirSel.appendChild(el('option', { value: '' }, 'Pilih kurir'));
    for (const k of out.kurir) {
      kurirSel.appendChild(el('option', { value: k.id_kurir }, `${k.kode_kurir} - ${k.nama_kurir}`));
    }
    shipmentOptionsLoaded = true;
  }

  async function ensureShipmentOptions(force) {
    if (shipmentOptionsLoaded && !force) return;
    await loadShipmentOptions();
  }

  async function loadShipments() {
    const params = new URLSearchParams();
    const q = document.getElementById('listQ').value;
    const status = document.getElementById('listStatus').value;
    const kurir = document.getElementById('listKurir').value;
    const orderStatus = document.getElementById('listOrderStatus').value;
    const sort = document.getElementById('listSort').value;
    if (q) params.set('q', q);
    if (status) params.set('status', status);
    if (kurir) params.set('kurir', kurir);
    if (orderStatus) params.set('order_status', orderStatus);
    if (sort) params.set('sort', sort);
    const rows = await API.get('/api/pengiriman' + (params.toString() ? '?' + params : ''));
    const tbody = document.getElementById('shipmentRows');
    clear(tbody);
    if (!rows.length) {
      tbody.appendChild(el('tr', null, el('td', { colspan: 7 }, 'Belum ada pengiriman.')));
      document.getElementById('shipmentResultInfo').textContent = 'Menampilkan 0 pengiriman.';
      return;
    }
    for (const s of rows) {
      tbody.appendChild(el('tr', null,
        el('td', null, el('a', { href: '/pesanan/' + s.id_pesanan }, '#TK-' + pad(s.id_pesanan, 4))),
        el('td', null, s.pelanggan_nama),
        el('td', null, `${s.kode_kurir} ${s.layanan || ''}`),
        el('td', null, s.no_resi),
        el('td', null, formatTanggal(s.tanggal_kirim)),
        el('td', null, statusLabel(window.STATUS_KIRIM, s.status_kirim)),
        el('td', null,
          el('a', { href: '/pengiriman/' + s.id_pengiriman + '/edit' }, 'Edit'),
          ' | ',
          el('button', {
            class: 'link-btn',
            onclick: async () => {
              if (!confirm('Hapus pengiriman ini? Riwayat tracking ikut terhapus.')) return;
              try {
                await API.del('/api/pengiriman/' + s.id_pengiriman);
                showSuccess('Pengiriman dihapus.');
                shipmentOptionsLoaded = false;
                await loadShipments();
                await loadKurirStats();
              } catch (err) { showError(err.message); }
            }
          }, 'Hapus')
        )
      ));
    }
    document.getElementById('shipmentResultInfo').textContent =
      `Menampilkan ${rows.length} pengiriman.`;
  }

  async function loadKurirStats() {
    const rows = await API.get('/api/pengiriman/kurir-stats');
    const tbody = document.getElementById('kurirRows');
    clear(tbody);

    let totT = 0, totK = 0, totP = 0;
    for (const k of rows) {
      tbody.appendChild(el('tr', null,
        el('td', null, `${k.nama_kurir} (${k.kode_kurir})`),
        el('td', null, String(k.total)),
        el('td', null, String(k.terkirim)),
        el('td', null, String(k.perjalanan))
      ));
      totT += k.total; totK += k.terkirim; totP += k.perjalanan;
    }
    tbody.appendChild(el('tr', null,
      el('td', null, el('strong', null, 'Total Aktif')),
      el('td', null, el('strong', null, String(totT))),
      el('td', null, el('strong', null, String(totK))),
      el('td', null, el('strong', null, String(totP)))
    ));
  }

  function renderTracking(data) {
    const wrap = document.getElementById('trackingDetail');
    clear(wrap);

    if (!data.tracking) {
      wrap.appendChild(el('p', null,
        'Masukkan nomor resi atau pilih kurir, lalu klik Cari untuk melacak paket.'
      ));
      return;
    }

    const { tracking, riwayat, pesanan, items, bayar } = data;

    wrap.innerHTML = `
      <section class="section">
        <div class="section-header">
          <div>
            <h3>Detail Tracking</h3>
            <p>Status kirim, resi, dan biaya paket.</p>
          </div>
          <div class="section-actions">
            <a href="/pesanan/${pesanan.id_pesanan}" class="btn">Buka Pesanan</a>
          </div>
        </div>
        <div class="section-body">
          <ul class="kv-list summary-list">
            <li>Kurir: ${tracking.nama_kurir} (${tracking.kode_kurir}) ${tracking.layanan || ''}</li>
            <li>No. Resi: <strong>${tracking.no_resi}</strong></li>
            <li>Status: <strong>${statusLabel(window.STATUS_KIRIM, tracking.status_kirim)}</strong></li>
            <li>Tanggal Kirim: ${formatTanggal(tracking.tanggal_kirim)}</li>
            <li>Estimasi Tiba: ${formatTanggal(tracking.estimasi_tiba)}</li>
            <li>Ongkos Kirim: ${rupiah(tracking.ongkos_kirim)}</li>
            <li>Berat Paket: ${tracking.total_berat_gram} gram</li>
          </ul>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <h3>Riwayat Perjalanan</h3>
            <p>Urutan update paket.</p>
          </div>
        </div>
        <div class="section-body">
          ${riwayat.length === 0
            ? '<p>Belum ada riwayat tracking.</p>'
            : `<table class="table">
                <thead><tr><th>Waktu</th><th>Lokasi</th><th>Keterangan</th></tr></thead>
                <tbody>
                  ${riwayat.map(rs => `
                    <tr>
                      <td>${formatTanggalJam(rs.waktu_update)}</td>
                      <td>${rs.lokasi || '-'}</td>
                      <td>${rs.deskripsi}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>`
          }
        </div>
      </section>

      <div class="page-split equal-split">
        <section class="section">
          <div class="section-header">
            <div>
              <h3>Alamat Penerima</h3>
              <p>Tujuan pengiriman.</p>
            </div>
          </div>
          <div class="section-body">
            <ul class="kv-list summary-list">
              <li>Penerima: ${pesanan.penerima}</li>
              <li>Telepon: ${pesanan.no_hp_penerima}</li>
              <li>Alamat: ${pesanan.alamat_lengkap}, ${pesanan.kota}, ${pesanan.provinsi} ${pesanan.kode_pos}</li>
            </ul>
          </div>
        </section>

        <section class="section">
          <div class="section-header">
            <div>
              <h3>Ringkasan Pesanan</h3>
              <p>#TK-${pad(pesanan.id_pesanan, 4)}</p>
            </div>
          </div>
          <div class="section-body">
            <table class="table">
              <thead><tr><th>Produk</th><th>Jumlah</th><th>Harga Satuan</th></tr></thead>
              <tbody>
                ${items.map(it => `
                  <tr>
                    <td>${it.nama_produk}</td>
                    <td>${it.jumlah}</td>
                    <td>${rupiah(it.harga_satuan)}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>

            <ul class="kv-list summary-list">
              <li>Subtotal Produk: ${rupiah(pesanan.total_harga)}</li>
              <li>Ongkos Kirim: ${rupiah(pesanan.ongkos_kirim)}</li>
              <li>Diskon: - ${rupiah(pesanan.diskon)}</li>
              <li>Total Bayar: <strong>${rupiah(pesanan.total_tagihan)}</strong></li>
            </ul>

            ${bayar ? `<p>
              Pembayaran <strong>${statusLabel(window.STATUS_BAYAR, bayar.status_bayar)}</strong>
              via ${metodeLabel(bayar.metode, bayar.nama_penyedia)}${bayar.tanggal_bayar
                ? ' pada ' + formatTanggalJam(bayar.tanggal_bayar) : ''}.
            </p>` : ''}
          </div>
        </section>
      </div>
    `;
  }

  async function loadTracking() {
    const params = new URLSearchParams();
    const q = document.getElementById('fQ').value;
    const kurir = document.getElementById('fKurir').value;
    if (q)     params.set('q', q);
    if (kurir) params.set('kurir', kurir);
    try {
      const data = await API.get('/api/pengiriman/track' + (params.toString() ? '?' + params : ''));
      renderTracking(data);
    } catch (err) { showError(err.message); }
  }

  document.getElementById('trackForm').addEventListener('submit', (e) => {
    e.preventDefault();
    loadTracking();
  });

  document.getElementById('shipmentFilterForm').addEventListener('submit', (e) => {
    e.preventDefault();
    loadShipments().catch(err => showError(err.message));
  });
  document.getElementById('listStatus').addEventListener('change', () => loadShipments().catch(err => showError(err.message)));
  document.getElementById('listKurir').addEventListener('change', () => loadShipments().catch(err => showError(err.message)));
  document.getElementById('listOrderStatus').addEventListener('change', () => loadShipments().catch(err => showError(err.message)));
  document.getElementById('listSort').addEventListener('change', () => loadShipments().catch(err => showError(err.message)));

  document.getElementById('addShipmentForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      await API.post('/api/pengiriman', {
        id_pesanan: document.getElementById('shipOrder').value,
        id_kurir: document.getElementById('shipKurir').value,
        layanan: document.getElementById('shipLayanan').value,
        no_resi: document.getElementById('shipResi').value,
        ongkos_kirim: Number(document.getElementById('shipOngkir').value),
        total_berat_gram: Number(document.getElementById('shipBerat').value),
        tanggal_kirim: document.getElementById('shipTanggal').value || undefined,
        estimasi_tiba: document.getElementById('shipEstimasi').value,
        status_kirim: document.getElementById('shipStatus').value,
        deskripsi_awal: document.getElementById('shipRiwayat').value
      });
      e.target.reset();
      document.getElementById('shipOngkir').value = 0;
      document.getElementById('shipBerat').value = 0;
      showSuccess('Pengiriman ditambahkan.');
      shipmentOptionsLoaded = false;
      await loadShipments();
      await loadKurirStats();
    } catch (err) { showError(err.message); }
  });

  document.querySelector('[data-toggle-panel="addShipmentPanel"]')?.addEventListener('click', () => {
    setTimeout(() => {
      if (!document.getElementById('addShipmentPanel').classList.contains('is-hidden')) {
        ensureShipmentOptions().catch(err => showError(err.message));
      }
    }, 0);
  });

  (async () => {
    initFilterOptions();
    const url = new URLSearchParams(location.search);
    if (url.get('list_q')) document.getElementById('listQ').value = url.get('list_q');
    if (url.get('status')) document.getElementById('listStatus').value = url.get('status');
    if (url.get('list_kurir')) document.getElementById('listKurir').value = url.get('list_kurir');
    if (url.get('order_status')) document.getElementById('listOrderStatus').value = url.get('order_status');
    if (url.get('sort')) document.getElementById('listSort').value = url.get('sort');
    if (url.get('q'))     document.getElementById('fQ').value = url.get('q');
    if (url.get('kurir')) document.getElementById('fKurir').value = url.get('kurir');
    await loadKurirStats();
    document.getElementById('shipmentResultInfo').textContent = '';
    renderTracking({ tracking: null });
  })();
</script>
