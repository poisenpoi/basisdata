<div class="page-stack">
  <section class="section">
    <div class="section-header">
      <div>
        <h3>Input Pembayaran</h3>
        <p>Input data pembayaran secara manual</p>
      </div>
      <div class="section-actions">
        <button type="button" class="btn" data-toggle-panel="addPaymentPanel" data-closed-label="Input Pembayaran" data-open-label="Tutup Input">Input Pembayaran</button>
      </div>
    </div>
    <div class="section-body input-panel is-hidden" id="addPaymentPanel">
      <form id="addForm" class="filter-bar">
        <label>
          Pesanan:
          <select id="idPesanan" required></select>
        </label>
        <label>
          Metode:
          <select id="metode" required>
            <option value="transfer_bank">Transfer Bank</option>
            <option value="e_wallet">E-Wallet</option>
            <option value="cod">COD</option>
          </select>
        </label>
        <label>
          Penyedia:
          <input type="text" id="penyedia" placeholder="BCA, OVO, COD...">
        </label>
        <label>
          Jumlah:
          <input type="number" id="jumlahBayar" min="0" required>
        </label>
        <label>
          Tanggal:
          <input type="datetime-local" id="tanggalBayar">
        </label>
        <label>
          Status:
          <select id="statusBayar">
            <option value="pending">Pending</option>
            <option value="berhasil">Berhasil</option>
            <option value="gagal">Gagal</option>
            <option value="refund">Refund</option>
          </select>
        </label>
        <button type="submit" class="btn btn-primary">Tambah Pembayaran</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h3>Daftar Pembayaran</h3>
        <p>Cari, filter by status/metode/status pesanan, sort by pembayaran, dan edit data</p>
      </div>
    </div>
    <div class="section-body">
      <form id="filterForm" class="filter-bar">
        <label class="filter-search">
          Cari:
          <input type="text" id="fQ" placeholder="ID pesanan, pelanggan, penyedia...">
        </label>
        <label>
          Filter By Status:
          <select id="fStatus">
            <option value="">Semua</option>
            <option value="pending">Pending</option>
            <option value="berhasil">Berhasil</option>
            <option value="gagal">Gagal</option>
            <option value="refund">Refund</option>
          </select>
        </label>

        <label>
          Filter By Metode:
          <select id="fMetode">
            <option value="">Semua</option>
            <option value="transfer_bank">Transfer Bank</option>
            <option value="e_wallet">E-Wallet</option>
            <option value="cod">COD</option>
          </select>
        </label>
        <label>
          Filter By Status Pesanan:
          <select id="fOrderStatus">
            <option value="">Semua</option>
            <option value="menunggu_bayar">Menunggu Bayar</option>
            <option value="diproses">Diproses</option>
            <option value="dikirim">Dikirim</option>
            <option value="selesai">Selesai</option>
            <option value="dibatalkan">Dibatalkan</option>
          </select>
        </label>
        <label>
          Sort By:
          <select id="fSort">
            <option value="terbaru">Terbaru</option>
            <option value="terlama">Terlama</option>
            <option value="tanggal_desc">Tanggal Bayar Terbaru</option>
            <option value="tanggal_asc">Tanggal Bayar Terlama</option>
            <option value="jumlah_desc">Jumlah Terbesar</option>
            <option value="jumlah_asc">Jumlah Terkecil</option>
            <option value="pelanggan_asc">Pelanggan A-Z</option>
            <option value="status">Status</option>
          </select>
        </label>
        <button type="submit" class="btn">Filter</button>
      </form>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>ID Pesanan</th>
              <th>Pelanggan</th>
              <th>Metode</th>
              <th>Jumlah</th>
              <th>Tanggal Bayar</th>
              <th>Status Pesanan</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="rows">
          </tbody>
        </table>
      </div>
      <p class="text-muted" id="resultInfo"></p>
    </div>
  </section>
</div>

<script>
  function pad(n, w) { return String(n).padStart(w, '0'); }
  let orderTotals = {};
  let paymentOptionsLoaded = false;

  async function loadOptions() {
    const out = await API.get('/api/pembayaran/options');
    const sel = document.getElementById('idPesanan');
    clear(sel);
    orderTotals = {};
    sel.appendChild(el('option', { value: '' }, 'Pilih pesanan'));
    for (const o of out.orders) {
      orderTotals[o.id_pesanan] = o.total_tagihan;
      sel.appendChild(el('option', { value: o.id_pesanan },
        `#TK-${pad(o.id_pesanan, 4)} - ${o.pelanggan_nama} - ${rupiah(o.total_tagihan)}`
      ));
    }
    paymentOptionsLoaded = true;
  }

  async function ensurePaymentOptions(force) {
    if (paymentOptionsLoaded && !force) return;
    await loadOptions();
  }

  async function load() {
    const params = new URLSearchParams();
    const q = document.getElementById('fQ').value;
    const s = document.getElementById('fStatus').value;
    const m = document.getElementById('fMetode').value;
    const orderStatus = document.getElementById('fOrderStatus').value;
    const sort = document.getElementById('fSort').value;
    if (q) params.set('q', q);
    if (s) params.set('status', s);
    if (m) params.set('metode', m);
    if (orderStatus) params.set('order_status', orderStatus);
    if (sort) params.set('sort', sort);
    try {
      const rows = await API.get('/api/pembayaran' + (params.toString() ? '?' + params : ''));
      const tbody = document.getElementById('rows');
      clear(tbody);
      if (!rows.length) {
        tbody.appendChild(el('tr', null, el('td', { colspan: 8 }, 'Tidak ada pembayaran.')));
        document.getElementById('resultInfo').textContent = 'Menampilkan 0 pembayaran.';
        return;
      }
      for (const b of rows) {
        tbody.appendChild(el('tr', null,
          el('td', null,
            el('a', { href: '/pesanan/' + b.id_pesanan }, '#TK-' + pad(b.id_pesanan, 4))
          ),
          el('td', null,
            txt(b.pelanggan_nama), el('br'),
            el('small', null, b.pelanggan_email)
          ),
          el('td', null, metodeLabel(b.metode, b.nama_penyedia)),
          el('td', null, rupiah(b.jumlah_bayar)),
          el('td', null, b.tanggal_bayar ? formatTanggalJam(b.tanggal_bayar) : '-'),
          el('td', null, statusLabel(window.STATUS_PESANAN, b.status_pesanan)),
          el('td', null, statusLabel(window.STATUS_BAYAR, b.status_bayar)),
          el('td', null,
            el('a', { href: '/pembayaran/' + b.id_pembayaran + '/edit' }, 'Edit'),
            ' | ',
            el('button', {
              class: 'link-btn',
              onclick: async () => {
                if (!confirm('Hapus pembayaran ini?')) return;
                try {
                  await API.del('/api/pembayaran/' + b.id_pembayaran);
                  showSuccess('Pembayaran dihapus.');
                  paymentOptionsLoaded = false;
                  load();
                } catch (err) { showError(err.message); }
              }
            }, 'Hapus')
          )
        ));
      }
      document.getElementById('resultInfo').textContent =
        `Menampilkan ${rows.length} pembayaran.`;
    } catch (err) { showError(err.message); }
  }

  document.getElementById('idPesanan').addEventListener('change', (e) => {
    const total = orderTotals[e.target.value];
    if (total != null) document.getElementById('jumlahBayar').value = Number(total);
  });

  document.getElementById('addForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      await API.post('/api/pembayaran', {
        id_pesanan: document.getElementById('idPesanan').value,
        metode: document.getElementById('metode').value,
        nama_penyedia: document.getElementById('penyedia').value,
        jumlah_bayar: Number(document.getElementById('jumlahBayar').value),
        tanggal_bayar: document.getElementById('tanggalBayar').value || undefined,
        status_bayar: document.getElementById('statusBayar').value
      });
      e.target.reset();
      showSuccess('Pembayaran ditambahkan.');
      paymentOptionsLoaded = false;
      load();
    } catch (err) { showError(err.message); }
  });

  document.querySelector('[data-toggle-panel="addPaymentPanel"]')?.addEventListener('click', () => {
    setTimeout(() => {
      if (!document.getElementById('addPaymentPanel').classList.contains('is-hidden')) {
        ensurePaymentOptions().catch(err => showError(err.message));
      }
    }, 0);
  });

  document.getElementById('fStatus').addEventListener('change', load);
  document.getElementById('fMetode').addEventListener('change', load);
  document.getElementById('fOrderStatus').addEventListener('change', load);
  document.getElementById('fSort').addEventListener('change', load);
  document.getElementById('filterForm').addEventListener('submit', (e) => {
    e.preventDefault();
    load();
  });
  document.getElementById('resultInfo').textContent = '';
</script>
