<div class="page-stack">
  <section class="section">
    <div class="section-header">
      <div>
        <h3>Input Pesanan</h3>
        <p>Buat pesanan baru secara manual</p>
      </div>
      <div class="section-actions">
        <button type="button" class="btn" data-toggle-panel="addOrderPanel" data-closed-label="Input Pesanan" data-open-label="Tutup Input">Input Pesanan</button>
      </div>
    </div>
    <div class="section-body input-panel is-hidden" id="addOrderPanel">
      <form id="addOrderForm" class="filter-bar">
        <label>
          Pelanggan / Alamat:
          <select id="orderAlamat" required></select>
        </label>
        <label>
          Produk:
          <select id="orderProduk" required></select>
        </label>
        <label>
          Jumlah:
          <input type="number" id="orderJumlah" min="1" value="1" required>
        </label>
        <label>
          Ongkir:
          <input type="number" id="orderOngkir" min="0" value="0">
        </label>
        <label>
          Diskon:
          <input type="number" id="orderDiskon" min="0" value="0">
        </label>
        <label>
          Status:
          <select id="orderStatus">
            <option value="menunggu_bayar">Menunggu Bayar</option>
            <option value="diproses">Diproses</option>
            <option value="dikirim">Dikirim</option>
            <option value="selesai">Selesai</option>
            <option value="dibatalkan">Dibatalkan</option>
          </select>
        </label>
        <label>
          Tanggal:
          <input type="datetime-local" id="orderTanggal">
        </label>
        <button type="submit" class="btn btn-primary">Tambah Pesanan</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h3>Daftar Pesanan</h3>
        <p>Cari, filter by pembayaran/pengiriman, sort by pesanan, dan detail pesanan</p>
      </div>
    </div>
    <div class="section-body">
      <form id="filterForm">
        <div class="filter-bar">
          <label class="filter-search">
            Cari:
            <input type="text" id="fQ" placeholder="ID atau nama pelanggan...">
          </label>
          <label>
            Filter By Status:
            <select id="fStatus">
              <option value="semua">Semua</option>
              <option value="menunggu_bayar">Menunggu Bayar</option>
              <option value="diproses">Diproses</option>
              <option value="dikirim">Dikirim</option>
              <option value="selesai">Selesai</option>
              <option value="dibatalkan">Dibatalkan</option>
            </select>
          </label>
          <label>
            Filter By Pembayaran:
            <select id="fBayarStatus">
              <option value="">Semua</option>
              <option value="belum_bayar">Belum Ada Data Bayar</option>
              <option value="pending">Pending</option>
              <option value="berhasil">Berhasil</option>
              <option value="gagal">Gagal</option>
              <option value="refund">Refund</option>
            </select>
          </label>
          <label>
            Filter By Metode:
            <select id="fMetode">
              <option value="">Semua</option>
              <option value="transfer_bank">Transfer Bank</option>
              <option value="e_wallet">E-Wallet</option>
              <option value="cod">COD</option>
            </select>
          </label>
          <label>
            Filter By Pengiriman:
            <select id="fHasShipping">
              <option value="">Semua</option>
              <option value="ya">Sudah Ada Pengiriman</option>
              <option value="tidak">Belum Ada Pengiriman</option>
            </select>
          </label>
          <label>
            Filter By Kurir:
            <select id="fKurir">
              <option value="">Semua</option>
            </select>
          </label>
          <label>
            Sort By:
            <select id="fSort">
              <option value="tanggal_desc">Tanggal Terbaru</option>
              <option value="tanggal_asc">Tanggal Terlama</option>
              <option value="total_desc">Total Terbesar</option>
              <option value="total_asc">Total Terkecil</option>
              <option value="pelanggan_asc">Pelanggan A-Z</option>
              <option value="pelanggan_desc">Pelanggan Z-A</option>
              <option value="status">Status</option>
            </select>
          </label>
          <button type="submit" class="btn">Filter</button>
        </div>
      </form>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>ID Pesanan</th>
              <th>Pelanggan</th>
              <th>Tanggal</th>
              <th>Total</th>
              <th>Pembayaran</th>
              <th>Kurir</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="rows">
          </tbody>
        </table>
      </div>

      <p class="text-muted" id="resultInfo"></p>
    </div>
  </section>
</div>

<script>
  const FILTER_KURIR = [
    { kode: 'JNE', label: 'JNE - JNE' },
    { kode: 'JNT', label: 'JNT - JNT' },
    { kode: 'SICEPAT', label: 'SICEPAT - SiCepat' }
  ];

  function pad(n, w) { return String(n).padStart(w, '0'); }

  let orderOptionsLoaded = false;

  async function loadOrderOptions() {
    const opts = await API.get('/api/pesanan/options');
    const alamatSel = document.getElementById('orderAlamat');
    const produkSel = document.getElementById('orderProduk');
    clear(alamatSel);
    clear(produkSel);

    alamatSel.appendChild(el('option', { value: '' }, 'Pilih alamat'));
    for (const a of opts.alamat) {
      alamatSel.appendChild(el('option', { value: a.id_alamat },
        `${a.pelanggan_nama} - ${a.label || 'Alamat'} - ${a.kota}, ${a.provinsi}`
      ));
    }

    produkSel.appendChild(el('option', { value: '' }, 'Pilih produk'));
    for (const p of opts.produk) {
      produkSel.appendChild(el('option', { value: p.id_produk },
        `${p.nama_produk} - ${rupiah(p.harga)} - stok ${p.stok}`
      ));
    }
    orderOptionsLoaded = true;
  }

  async function ensureOrderOptions(force) {
    if (orderOptionsLoaded && !force) return;
    await loadOrderOptions();
  }

  function loadKurirFilter() {
    const sel = document.getElementById('fKurir');
    while (sel.options.length > 1) sel.remove(1);
    for (const k of FILTER_KURIR) {
      sel.appendChild(el('option', { value: k.kode }, k.label));
    }
  }

  async function loadList(status, q) {
    const params = new URLSearchParams();
    if (status && status !== 'semua') params.set('status', status);
    if (q) params.set('q', q);
    const bayarStatus = document.getElementById('fBayarStatus').value;
    const metode = document.getElementById('fMetode').value;
    const hasShipping = document.getElementById('fHasShipping').value;
    const kurir = document.getElementById('fKurir').value;
    const sort = document.getElementById('fSort').value;
    if (bayarStatus) params.set('bayar_status', bayarStatus);
    if (metode) params.set('metode', metode);
    if (hasShipping) params.set('has_shipping', hasShipping);
    if (kurir) params.set('kurir', kurir);
    if (sort) params.set('sort', sort);
    return API.get('/api/pesanan' + (params.toString() ? '?' + params : ''));
  }

  function renderRows(rows) {
    const tbody = document.getElementById('rows');
    clear(tbody);
    if (!rows.length) {
      tbody.appendChild(el('tr', null, el('td', { colspan: 8 }, 'Tidak ada pesanan.')));
      return;
    }
    for (const o of rows) {
      const pelangganCell = el('td', null,
        txt(o.pelanggan_nama), el('br'),
        el('small', null, o.pelanggan_email)
      );

      const bayarCell = el('td');
      if (o.bayar_metode) {
        bayarCell.appendChild(txt(metodeLabel(o.bayar_metode, o.bayar_penyedia)));
        bayarCell.appendChild(el('br'));
        bayarCell.appendChild(el('small', null, statusLabel(window.STATUS_BAYAR, o.status_bayar)));
      } else {
        bayarCell.appendChild(txt('-'));
      }

      tbody.appendChild(el('tr', null,
        el('td', null, '#TK-' + pad(o.id_pesanan, 4)),
        pelangganCell,
        el('td', null, formatTanggal(o.tanggal_pesan)),
        el('td', null, rupiah(o.total_tagihan)),
        bayarCell,
        el('td', null, o.kode_kurir || '-'),
        el('td', null, statusLabel(window.STATUS_PESANAN, o.status_pesanan)),
        el('td', null,
          el('a', { href: '/pesanan/' + o.id_pesanan }, 'Lihat'),
          ' | ',
          el('button', {
            class: 'link-btn',
            onclick: async () => {
              if (!confirm('Hapus pesanan ini? Pembayaran dan pengiriman terkait ikut terhapus.')) return;
              try {
                await API.del('/api/pesanan/' + o.id_pesanan);
                showSuccess('Pesanan dihapus.');
                loadAll(document.getElementById('fStatus').value || 'semua');
              } catch (err) { showError(err.message); }
            }
          }, 'Hapus')
        )
      ));
    }
  }

  async function loadAll(status) {
    try {
      const q = document.getElementById('fQ').value;
      const out = await loadList(status, q);
      renderRows(out.data);
      document.getElementById('resultInfo').textContent =
        `Menampilkan ${out.data.length} pesanan.`;
    } catch (err) { showError(err.message); }
  }

  document.getElementById('filterForm').addEventListener('submit', (e) => {
    e.preventDefault();
    loadAll(document.getElementById('fStatus').value || 'semua');
  });
  document.getElementById('fStatus').addEventListener('change', () => loadAll(document.getElementById('fStatus').value || 'semua'));
  document.getElementById('fBayarStatus').addEventListener('change', () => loadAll(document.getElementById('fStatus').value || 'semua'));
  document.getElementById('fMetode').addEventListener('change', () => loadAll(document.getElementById('fStatus').value || 'semua'));
  document.getElementById('fHasShipping').addEventListener('change', () => loadAll(document.getElementById('fStatus').value || 'semua'));
  document.getElementById('fKurir').addEventListener('change', () => loadAll(document.getElementById('fStatus').value || 'semua'));
  document.getElementById('fSort').addEventListener('change', () => loadAll(document.getElementById('fStatus').value || 'semua'));

  document.getElementById('addOrderForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      await API.post('/api/pesanan', {
        id_alamat: document.getElementById('orderAlamat').value,
        id_produk: document.getElementById('orderProduk').value,
        jumlah: Number(document.getElementById('orderJumlah').value),
        ongkos_kirim: Number(document.getElementById('orderOngkir').value),
        diskon: Number(document.getElementById('orderDiskon').value),
        status_pesanan: document.getElementById('orderStatus').value,
        tanggal_pesan: document.getElementById('orderTanggal').value || undefined
      });
      e.target.reset();
      document.getElementById('orderJumlah').value = 1;
      document.getElementById('orderOngkir').value = 0;
      document.getElementById('orderDiskon').value = 0;
      showSuccess('Pesanan ditambahkan.');
      orderOptionsLoaded = false;
      loadAll(document.getElementById('fStatus').value || 'semua');
    } catch (err) { showError(err.message); }
  });

  document.querySelector('[data-toggle-panel="addOrderPanel"]')?.addEventListener('click', () => {
    setTimeout(() => {
      if (!document.getElementById('addOrderPanel').classList.contains('is-hidden')) {
        ensureOrderOptions().catch(err => showError(err.message));
      }
    }, 0);
  });

  const url = new URLSearchParams(location.search);
  const initStatus = url.get('status') || 'semua';
  document.getElementById('fStatus').value = initStatus;
  if (url.get('q')) document.getElementById('fQ').value = url.get('q');
  if (url.get('bayar_status')) document.getElementById('fBayarStatus').value = url.get('bayar_status');
  if (url.get('metode')) document.getElementById('fMetode').value = url.get('metode');
  if (url.get('has_shipping')) document.getElementById('fHasShipping').value = url.get('has_shipping');
  if (url.get('sort')) document.getElementById('fSort').value = url.get('sort');
  loadKurirFilter();
  if (url.get('kurir')) document.getElementById('fKurir').value = url.get('kurir');
  document.getElementById('resultInfo').textContent = '';
</script>
