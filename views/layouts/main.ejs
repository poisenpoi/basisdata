<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'TokoKita Admin' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <script>
    window.STATUS_PESANAN = <%- JSON.stringify(STATUS_PESANAN) %>;
    window.STATUS_KIRIM   = <%- JSON.stringify(STATUS_KIRIM) %>;
    window.STATUS_BAYAR   = <%- JSON.stringify(STATUS_BAYAR) %>;
    window.CURRENT_USER   = <%- JSON.stringify(currentUser || null) %>;
  </script>
  <script src="/js/api.js"></script>
</head>
<body>

<div class="app-shell">
  <%- include('../partials/header') %>

  <main class="main">
    <%- include('../partials/topbar', {
      pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : title,
      breadcrumb: typeof breadcrumb !== 'undefined' ? breadcrumb : ''
    }) %>

    <div class="content">
      <div id="flash"></div>
      <%- body %>
    </div>

    <footer class="site-footer">
      <div>
        <strong>TokoKita Admin</strong>
        <span>Panel operasional toko</span>
      </div>
      <div class="footer-meta">
        REST API / MySQL / Session Auth
      </div>
    </footer>
  </main>
</div>

</body>
</html>
